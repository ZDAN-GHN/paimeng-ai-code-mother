{
  "description": "派蒙 AI 代码母体编码规范：上下文注入 + 危险操作拦截",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \".codex/hooks/enforce-coding-standards.cjs\" --event=SessionStart",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \".codex/hooks/enforce-coding-standards.cjs\" --event=UserPromptSubmit",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \".codex/hooks/enforce-coding-standards.cjs\" --event=PreToolUse",
            "timeout": 5,
            "statusMessage": "检查编码规范合规性..."
          }
        ]
      }
    ]
  }
}
