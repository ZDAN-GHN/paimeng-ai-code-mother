'use strict';

/**
 * paimeng-ai-code-mother - Codex 编码规范执行器
 *
 * 职责：
 *  1. SessionStart      读取 coding-standards.md 全文注入上下文
 *  2. UserPromptSubmit  注入精简提醒
 *  3. PreToolUse        拦截高危操作
 *
 * 协议：stdin 读 JSON，stdout 写 JSON。
 *  - 注入: { hookSpecificOutput: { hookEventName, additionalContext } }
 *  - 拦截: { hookSpecificOutput: { hookEventName: 'PreToolUse',
 *            permissionDecision: 'deny', permissionDecisionReason } }
 *  - 放行: 无输出（退出码 0）
 */

const nodePath = require('node:path');
const nodeFs = require('node:fs');
const { execFileSync } = require('node:child_process');

// ==================== 环境发现 ====================

// 脚本位于 <repo>/.codex/hooks/ ，据此定位规范文件与仓库根
const HOOKS_DIR = __dirname;
const REPO_ROOT = nodePath.resolve(HOOKS_DIR, '..', '..');
const STANDARDS_PATH = nodePath.join(HOOKS_DIR, 'coding-standards.md');

// ==================== 工具分类 ====================

function classifyTool(toolName) {
  const name = String(toolName || '');
  if (name === 'apply_patch' || name === 'Edit' || name === 'Write') return 'write';
  if (name === 'Bash' || name === 'exec_command' || name === 'shell_command') return 'shell';
  return 'other';
}

function extractCommand(toolInput) {
  if (typeof toolInput === 'string') return toolInput.trim();
  if (!toolInput || typeof toolInput !== 'object') return '';
  return String(toolInput.command || toolInput.cmd || '').trim();
}

function extractFilePaths(toolName, toolInput) {
  const paths = [];
  if (!toolInput || typeof toolInput !== 'object') return paths;

  if (toolName === 'Edit' || toolName === 'Write') {
    const filePath = toolInput.file_path || toolInput.path;
    if (filePath) paths.push(String(filePath));
  } else if (toolName === 'apply_patch') {
    const patch = String(toolInput.patch || toolInput.content || toolInput.input || '');
    const lines = patch.split(/\r?\n/);
    for (const line of lines) {
      const m = /^\*\*\* (?:Add|Update|Delete) File:\s*(.+?)\s*$/.exec(line)
        || /^\*\*\* Move to:\s*(.+?)\s*$/.exec(line);
      if (m) paths.push(m[1]);
    }
  }

  return paths.map(function (p) { return String(p).replace(/\\/g, '/'); });
}

// ==================== 拦截规则 ====================

const SENSITIVE_PATTERNS = [
  /application-local\.ya?ml$/i,
  /(?:^|\/)\.env$/
];

function checkSensitiveFiles(toolName, toolInput) {
  const filePaths = extractFilePaths(toolName, toolInput);
  for (const filePath of filePaths) {
    for (const pattern of SENSITIVE_PATTERNS) {
      if (pattern.test(filePath)) {
        return {
          deny: true,
          reason: '禁止写入敏感配置文件：' + filePath + '\n'
            + '该文件含 API keys 且已 gitignore。如确需修改，请手动编辑或改用 application.yml 模板。'
        };
      }
    }
  }
  return { deny: false };
}

function checkGitForcePush(command) {
  // --force-with-lease 相对安全，放行
  if (/\bgit\s+push\b/.test(command)
      && /(?:--force(?!-with-lease)|\s-f\b)/.test(command)) {
    return {
      deny: true,
      reason: 'git push --force 会覆盖远程历史，可能导致团队成员代码丢失。\n'
        + '如确有必要，请改用 --force-with-lease，或由人工手动执行。'
    };
  }
  return { deny: false };
}

function checkMavenWrapper(command) {
  // 命中裸 mvn，但不匹配 mvnw / mvnw.cmd / ./mvnw
  if (/(?:^|[\s;|&(])mvn(?![\w.-])/.test(command)) {
    return {
      deny: true,
      reason: '请使用 Maven Wrapper 保证版本一致：\n'
        + '  Windows: mvnw.cmd 或 .\\mvnw\n'
        + '  Linux/macOS: ./mvnw'
    };
  }
  return { deny: false };
}

function checkCoAuthoredBy(command) {
  if (!/\bgit\s+commit\b/.test(command)) return { deny: false };
  // 只检查带内联消息的提交；开编辑器或 --amend --no-edit 无法可靠判定，放行
  const hasInlineMessage = /(?:\s-m\b|--message\b|\s-F\b|--file\b)/.test(command);
  if (!hasInlineMessage) return { deny: false };
  if (/Co-Authored-By:\s*Codex/i.test(command)) return { deny: false };
  return {
    deny: true,
    reason: 'AGENTS.md 要求 AI 提交必须包含署名尾注，请在提交消息末尾加入：\n'
      + 'Co-Authored-By: Codex <codex@openai.com>'
  };
}

const SHELL_CHECKS = [checkGitForcePush, checkMavenWrapper, checkCoAuthoredBy];

// ==================== 事件处理 ====================

function gitHooksPathHint() {
  try {
    const out = execFileSync('git', ['config', '--get', 'core.hooksPath'], {
      cwd: REPO_ROOT,
      encoding: 'utf8',
      stdio: ['ignore', 'pipe', 'ignore'],
      timeout: 2000
    });
    if (String(out).trim()) return '';
  } catch (err) {
    // git 缺失或未配置：一律给出提示
  }
  return '\n> [提醒] Git 侧校验未启用。运行 `git config core.hooksPath .githooks`'
    + ' 可激活 pre-commit 的 ESLint / Prettier / Java 命名与阿里规约检查。\n';
}

function readStandards() {
  return nodeFs.readFileSync(STANDARDS_PATH, 'utf8');
}

function contextOutput(eventName, text) {
  return { hookSpecificOutput: { hookEventName: eventName, additionalContext: text } };
}

function handleSessionStart() {
  try {
    return contextOutput('SessionStart', readStandards() + gitHooksPathHint());
  } catch (err) {
    return contextOutput('SessionStart',
      '[Hook] 无法读取 .codex/hooks/coding-standards.md：' + err.message);
  }
}

function handleUserPromptSubmit() {
  // 每轮只注入精简提醒，全文已在 SessionStart 注入过
  const reminder = [
    '[项目规范提醒]',
    '- 用中文回复；代码、标识符、日志、CLI 命令保持英文原文。',
    '- 最小改动：只改必须改的，不顺手重构或调整无关格式。',
    '- 后端遵循阿里巴巴 Java 开发手册；前端 Prettier 无分号/单引号/100 宽。',
    '- 构建用 ./mvnw 或 mvnw.cmd，不要用全局 mvn。',
    '- 提交必须带 Co-Authored-By: Codex <codex@openai.com>。',
    '- 完整规范见 .codex/hooks/coding-standards.md。'
  ].join('\n');
  return contextOutput('UserPromptSubmit', reminder);
}

function denyOutput(reason) {
  return {
    hookSpecificOutput: {
      hookEventName: 'PreToolUse',
      permissionDecision: 'deny',
      permissionDecisionReason: reason
    }
  };
}

function handlePreToolUse(input) {
  const toolName = String(input.tool_name || '');
  const toolInput = input.tool_input;
  const kind = classifyTool(toolName);

  if (kind === 'write') {
    const result = checkSensitiveFiles(toolName, toolInput);
    if (result.deny) return denyOutput(result.reason);
    return null;
  }

  if (kind === 'shell') {
    const command = extractCommand(toolInput);
    if (!command) return null;
    for (const check of SHELL_CHECKS) {
      const result = check(command);
      if (result.deny) return denyOutput(result.reason);
    }
  }

  return null;
}

const HANDLERS = {
  SessionStart: handleSessionStart,
  UserPromptSubmit: handleUserPromptSubmit,
  PreToolUse: handlePreToolUse
};

// ==================== 主入口 ====================

function resolveEventName(input) {
  if (input && input.hook_event_name) return String(input.hook_event_name);
  const arg = process.argv.slice(2).find(function (a) { return a.indexOf('--event=') === 0; });
  return arg ? arg.slice('--event='.length) : '';
}

function run(rawInput) {
  let input = {};
  try {
    input = rawInput ? JSON.parse(rawInput) : {};
  } catch (err) {
    input = {};
  }

  const handler = HANDLERS[resolveEventName(input)];
  if (!handler) return;

  const output = handler(input);
  if (output) process.stdout.write(JSON.stringify(output));
}

function main() {
  const chunks = [];
  process.stdin.on('data', function (chunk) { chunks.push(chunk); });
  process.stdin.on('error', function () { run(''); });
  process.stdin.on('end', function () {
    try {
      run(Buffer.concat(chunks).toString('utf8'));
    } catch (err) {
      // hook 自身异常绝不阻断会话
      process.stderr.write('[coding-standards hook] ' + err.message + '\n');
    }
  });
}

main();
