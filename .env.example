# 复制为 .env 后使用：cp .env.example .env
# .env 含真实密码，已被 .gitignore 排除，不得提交。
# 与 src/main/resources/application-local.yml 的 spring.datasource.password 保持一致。
MYSQL_ROOT_PASSWORD=change-me

# PostgreSQL session-event store (local compose only; do not commit the real password)
POSTGRES_DB=paimeng
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
