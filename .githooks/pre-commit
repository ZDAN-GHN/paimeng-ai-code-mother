#!/usr/bin/env bash
# pre-commit hook for paimeng-ai-code-mother
# 编码规范检查：前端 ESLint/Prettier + 后端命名与阿里巴巴规约
#
# 启用: git config core.hooksPath .githooks
# 跳过: git commit --no-verify

set -u

# Git for Windows 下 grep/sed/basename 在 /usr/bin
export PATH="/usr/bin:$PATH"

STAGED=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$STAGED" ] && exit 0

FAILED=0
REPO_ROOT=$(git rev-parse --show-toplevel)
FRONTEND_DIR=paimeng-ai-code-mother-frontend

echo "[hook] 编码规范检查"

# ---------- 1. 敏感文件 ----------
# application-local.yml 含 API key，AGENTS.md 要求不入版本控制
SECRETS=$(printf "%s\n" "$STAGED" | grep -E "application-local\.ya?ml$|(^|/)\.env$" || true)
if [ -n "$SECRETS" ]; then
  echo "  [FAIL] 禁止提交敏感配置文件:"
  printf "         %s\n" $SECRETS
  FAILED=1
fi

# ---------- 2. 前端: ESLint + Prettier ----------
FE=$(printf "%s\n" "$STAGED" | grep -E "^$FRONTEND_DIR/.*\.(ts|tsx|vue|js|mjs)$" || true)
if [ -n "$FE" ]; then
  FE_REL=$(printf "%s\n" "$FE" | sed "s|^$FRONTEND_DIR/||")
  cd "$REPO_ROOT/$FRONTEND_DIR" || exit 1

  if [ ! -d node_modules ]; then
    echo "  [SKIP] 前端: node_modules 缺失，请先 npm install"
  else
    # 不加 --fix: hook 不改动已暂存内容，否则提交的与检查的不一致
    if printf "%s\n" $FE_REL | xargs npx --no-install eslint --max-warnings 0; then
      echo "  [ok]   ESLint"
    else
      echo "  [FAIL] ESLint -> cd $FRONTEND_DIR && npm run lint"
      FAILED=1
    fi

    # .prettierrc.json: semi=false singleQuote=true printWidth=100
    if printf "%s\n" $FE_REL | xargs npx --no-install prettier --check; then
      echo "  [ok]   Prettier"
    else
      echo "  [FAIL] Prettier -> cd $FRONTEND_DIR && npm run format"
      FAILED=1
    fi
  fi

  cd "$REPO_ROOT" || exit 1
fi

# ---------- 3. 后端 Java ----------
# 依据阿里巴巴 Java 开发手册，与 .idea/inspectionProfiles 已启用规则对齐
JAVA=$(printf "%s\n" "$STAGED" | grep -E "\.java$" | grep -v "^$FRONTEND_DIR/" || true)
if [ -n "$JAVA" ]; then
  NAMING=0
  RULES=0

  for f in $JAVA; do
    name=$(basename "$f" .java)
    # 读暂存版本内容，而非工作区
    body=$(git show ":$f" 2>/dev/null || true)

    # AlibabaClassNamingShouldBeCamel
    if ! printf "%s" "$name" | grep -qE "^[A-Z][A-Za-z0-9]*$"; then
      echo "  [FAIL] $f: 类名应为大驼峰 UpperCamelCase"
      NAMING=1
    fi

    # AlibabaServiceOrDaoClassShouldEndWithImpl
    case "$f" in
      */service/impl/*)
        printf "%s" "$name" | grep -qE "Impl$" || {
          echo "  [FAIL] $f: Service 实现类应以 Impl 结尾"; NAMING=1; }
        ;;
    esac

    # AlibabaExceptionClassShouldEndWithException
    # 按「是否继承 Exception」判定，而非所在目录：
    # exception 包下的 ErrorCode / ThrowUtils / GlobalExceptionHandler 不是异常类
    if printf "%s\n" "$body" | grep -qE "^[[:space:]]*(public|final|abstract|[[:space:]])*class[[:space:]]+$name\b[^{]*extends[[:space:]]+[A-Za-z0-9_.]*(Exception|Error|Throwable)\b"; then
      printf "%s" "$name" | grep -qE "Exception$" || {
        echo "  [FAIL] $f: 继承异常的类应以 Exception 结尾"; NAMING=1; }
    fi

    # AlibabaTestClassShouldEndWithTestNaming
    # 放行 Tests: Spring Boot 生成的 *ApplicationTests 是既有约定
    case "$f" in
      */src/test/java/*|src/test/java/*)
        printf "%s" "$name" | grep -qE "Tests?$" || {
          echo "  [FAIL] $f: 测试类应以 Test 或 Tests 结尾"; NAMING=1; }
        ;;
    esac

    # ---- 禁用写法：只查本次新增行，不追溯存量代码 ----
    ADDED=$(git diff --cached -U0 -- "$f" | grep "^+" | grep -v "^+++" || true)
    [ -z "$ADDED" ] && continue

    if printf "%s\n" "$ADDED" | grep -qE "System\.(out|err)\.print"; then
      echo "  [FAIL] $f: 禁用 System.out/err.print，请用 @Slf4j 日志"
      RULES=1
    fi

    if printf "%s\n" "$ADDED" | grep -qF ".printStackTrace()"; then
      echo "  [FAIL] $f: 禁用 printStackTrace()，请用 log.error(msg, e)"
      RULES=1
    fi

    # AliLongLiteralsEndingWithLowercaseL: 小写 l 易与数字 1 混淆
    if printf "%s\n" "$ADDED" | grep -qE "(^|[^A-Za-z0-9_.])[0-9]+l([^A-Za-z0-9_]|$)"; then
      echo "  [FAIL] $f: Long 字面量请用大写 L (如 100L)"
      RULES=1
    fi
  done

  if [ "$NAMING" -eq 0 ]; then echo "  [ok]   Java 命名规范"; else FAILED=1; fi
  if [ "$RULES" -eq 0 ]; then echo "  [ok]   阿里巴巴规约"; else FAILED=1; fi
fi

# ---------- 结果 ----------
if [ "$FAILED" -ne 0 ]; then
  echo "[hook] 检查未通过，已阻止提交"
  exit 1
fi

echo "[hook] 通过"
exit 0
