{
  "name": "application-template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.20.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "db:generate": "prisma generate",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:deploy": "prisma migrate deploy",
    "type-check": "npm run db:generate && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.test.json && vue-tsc -p tsconfig.web.json --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "build": "npm run type-check && tsc -p tsconfig.server.json && vite build",
    "start": "node dist/server/server.js"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/client": "7.10.0",
    "fastify": "5.12.3",
    "vue": "3.5.17"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@vitejs/plugin-vue": "6.0.0",
    "prisma": "7.10.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vue-tsc": "2.2.12"
  },
  "overrides": {
    "@prisma/adapter-mariadb": {
      "mariadb": "3.4.7"
    },
    "@prisma/config": {
      "deepmerge-ts": "8.0.0"
    },
    "prisma": {
      "mysql2": "3.23.1"
    }
  }
}
