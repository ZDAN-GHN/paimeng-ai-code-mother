DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/paimeng_app
# 固定窗口生成限流；连接失败时放行并记录结构化 warn。测试使用独立的 Redis DB15。
REDIS_URL=redis://127.0.0.1:6379/0
APP_ORIGIN=http://localhost:3000
PREVIEW_ORIGIN=http://127.0.0.1:3001
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_MODE=provider
# 允许作为模型密钥引用的额外环境变量名，逗号分隔；AI_API_KEY 始终允许。
MODEL_API_KEY_ENV_ALLOWLIST=
# 直接输入密钥的加密主密钥：64 位十六进制、32 字节 base64，或任意长度口令（scrypt 派生）。
# 留空则自动生成并写入 runtime/model-secret.key（权限 600）；该文件丢失后已保存的密钥无法解密，需要重新输入。
MODEL_SECRET_KEY=
# 额外允许的非 HTTPS 模型地址来源（origin），逗号分隔。本机与局域网字面量（localhost、127.0.0.0/8、10/8、172.16/12、192.168/16、::1）默认放行，不需要写在这里；这里只列其它来源，例如 http://model-gateway.corp:8080。
MODEL_INTERNAL_BASE_URL_ORIGINS=
# 生成限流，默认等价于旧版按用户每 60 秒 1 次，次数 1-1000、窗口 1-86400 秒。
# API = 整个生成接口共用一个窗口，USER = 按登录用户，IP = 按 X-Forwarded-For/X-Real-IP（要求前置代理覆盖这两个头）。
CHAT_RATE_LIMIT_TYPE=USER
CHAT_RATE_LIMIT_RATE=1
CHAT_RATE_LIMIT_INTERVAL=60
CHAT_RATE_LIMIT_MESSAGE=
BUILD_IMAGE=node:24-alpine
# 容器内 npm 使用的 registry。国内网络直连官方源很慢（实测 antd 元数据 0.4 MB/s，整棵依赖树会超过构建预算并 ECONNRESET），
# 可按机器换成镜像（如 https://registry.npmmirror.com）；锁文件带 integrity，镜像无法改变装出来的产物内容。
BUILD_NPM_REGISTRY=https://registry.npmjs.org
# 单条容器构建命令（npm ci/install、类型检查、vite build）的预算，毫秒，10000-1800000。
# 整机负载高时容器内 npm install 会明显变慢，可按机器调整；跑真实 Docker 构建的测试用它换余量。
BUILD_TIMEOUT_MS=180000
# 构建失败后允许模型修复的轮数，0-3，默认 2；0 表示关闭修复（失败即结束）。
# 只有能定位到生成源码的失败（源码校验、类型检查、打包）才会进入修复轮；安装失败、构建超时、平台错误与模型未改动源码都会直接结束。
# 工具循环不设步数上限；修复轮受此配置约束，源码未改动时可复用已有构建。
BUILD_REPAIR_ROUNDS=2
# 整次生成任务（模型阶段 + 构建阶段）的时长上限，毫秒，0 表示不限制（默认 0，旧版写死 10 分钟）。
# 容器命令预算见 BUILD_TIMEOUT_MS；harness 流请求期限由 harness-server.ts 的 settings.stream 配置。
GENERATION_TIMEOUT_MS=0
GENERATION_MAX_CONCURRENT=4

# --- 联网工具（webSearch / readWebPage / searchImages / importImage）---
# 总开关。默认关闭：免密钥通道意味着查询内容和目标 URL 会发给第三方服务商，需要管理员显式打开。
# 关闭时这四个工具不会注册给模型；历史消息里已有的工具结果仍可正常读取。
WEB_ACCESS_ENABLED=false
# 可选。留空即使用 Tavily 免密钥模式（无账号、无 key，响应格式与带 key 一致，但有共享额度限制）。
# 注册免费账号可得每月 1000 credits（basic 搜索 1 credit/次，basic 提取 5 个成功 URL/credit），只提高限额，不需要改代码。
WEB_ACCESS_TAVILY_API_KEY=
# 图片工具（searchImages / importImage）独立开关，仅在总开关打开时生效。
WEB_ACCESS_IMAGES=true
# 严格许可模式：只允许导入许可可核验的素材（Openverse，CC0/PDM/CC BY）。
# 默认 false 时还会使用通用网络图片（Tavily 图片结果），它们的授权状态未知，工具结果与署名页会明确标注。
WEB_ACCESS_STRICT_LICENSE=false
# 网页正文在服务商提取失败时，是否允许回退到免密钥的 Jina Reader（目标 URL 会发给 Jina）。
WEB_ACCESS_JINA_FALLBACK=false
# 允许解析到的额外网段，逗号分隔。仅用于本机 TUN/Clash 式 fake-IP 环境：这类环境的 DNS 会把所有外网域名
# 同时解析到 198.18.0.0/15（A 记录）与 2001:2::/48（AAAA 记录），不配置会让校验直接拒绝所有目标，
# 两个网段都要写。只接受 benchmarking / documentation 类别内的网段，私网、环回、链路本地与云元数据
# 地址始终拒绝，无法通过这里放行。例：198.18.0.0/15,2001:2::/48
WEB_ACCESS_ALLOW_NETWORKS=
# 可选 http(s) 代理。配置后由代理解析目标地址并在出口拦截内网访问（本地只拒绝字面量内网地址）。
WEB_ACCESS_PROXY=

DURABLE_HARNESS_URL=http://127.0.0.1:5599

DURABLE_PG_URL=postgres://postgres:postgres@127.0.0.1:5432/paimeng_agent
DURABLE_HARNESS_PORT=5599
# 生成默认每轮读取产品库 codegen.default；管理端保存后下一次运行生效，无需重启 harness。
# 本地/CI 若需绕过产品模型配置，显式同时设置下面三项；任意缺项会报配置错误，不会回退。
DURABLE_MODEL_BASE_URL=
DURABLE_MODEL_API_KEY=
DURABLE_MODEL_ID=
