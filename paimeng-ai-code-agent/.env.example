# 服务端口（Java 8123 / RAG 8091 之外，本服务约定 8092）
PORT=8092

# 与 Java 侧共享的 JWT 签名密钥（HS256，Java 以 /app/agent/token 签发、Agent 离线验签；#12 已落地，取 Java 侧 agent.jwt.secret 同一值）
JWT_SECRET=change-me-shared-with-java

# 工作区根目录：必须与 Java 的 CODE_OUTPUT_ROOT_DIR（仓库 runtime/tmp/code_output）指向同一绝对路径
# 相对路径以本目录为基准解析
WORKSPACE_ROOT=../runtime/tmp/code_output

# 日志级别（fastify pino）
LOG_LEVEL=info

# Java 内部 API（generation_run 读写，#4）：base-url 含 Java 的 context-path（/api）
# token 必须与 Java 侧 internal-api.token（application.yml / INTERNAL_API_TOKEN）一致
JAVA_INTERNAL_BASE_URL=http://localhost:8123/api
JAVA_INTERNAL_TOKEN=dev-token

# PostgreSQL session-event store（与根目录 compose 的 postgres 服务一致）
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=paimeng
PGUSER=postgres
PGPASSWORD=change-me

# 图片四工具密钥（Issue #8）：内容图搜索用 Pexels、Logo 生成用阿里云百炼 DashScope；
# 未配置时对应工具返回空结果（不报错）；图片配额 4 张/run 由 Agent 侧强制
PEXELS_API_KEY=
DASHSCOPE_API_KEY=
# Logo 生成模型（默认对齐 Java LogoGeneratorTool）
IMAGE_MODEL=wan2.2-t2i-flash

# ── 真实 LLM 渠道（Alibaba Coding Plan；密钥不提交，本文件只留模板）──
# 仅使用 DashScope Coding OpenAI 兼容端点；密钥为空时离线回退 fake LLM（零在线调用）。
DASHSCOPE_CODING_API_KEY=
# DASHSCOPE_CODING_BASE_URL=https://coding.dashscope.aliyuncs.com/v1

# 五档模型 id 映射（缺省用 src/llm/real.ts 内置选型）：
#   MODEL_ROUTER   → qwen3.7-plus（任务路由）
#   MODEL_FAST     → qwen3-coder-next（短小、局部代码任务）
#   MODEL_STANDARD → qwen3-coder-plus（主力代码生成）
#   MODEL_DEEP     → qwen3.7-plus（复杂 Debug / 最终修复）
#   MODEL_QUALITY  → qwen3.7-plus（结构化质检）
# MODEL_ROUTER=
# MODEL_FAST=
# MODEL_STANDARD=
# MODEL_DEEP=
# MODEL_QUALITY=
