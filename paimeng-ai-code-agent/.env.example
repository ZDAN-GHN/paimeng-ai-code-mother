# 服务端口（Java 8123 / RAG 8091 之外，本服务约定 8092）
PORT=8092

# 与 Java 侧共享的 JWT 签名密钥（HS256，Java 以 /app/agent/token 签发、Agent 离线验签；#12 已落地，取 Java 侧 agent.jwt.secret 同一值）
JWT_SECRET=change-me-shared-with-java

# 工作区根目录：必须与 Java 的 CODE_OUTPUT_ROOT_DIR（user.dir/tmp/code_output）指向同一绝对路径
# 相对路径以本目录为基准解析
WORKSPACE_ROOT=../tmp/code_output

# 日志级别（fastify pino）
LOG_LEVEL=info

# Java 内部 API（generation_run 读写，#4）：base-url 含 Java 的 context-path（/api）
# token 必须与 Java 侧 internal-api.token（application.yml / INTERNAL_API_TOKEN）一致
JAVA_INTERNAL_BASE_URL=http://localhost:8123/api
JAVA_INTERNAL_TOKEN=dev-token

# 图片四工具密钥（Issue #8）：内容图搜索用 Pexels、Logo 生成用阿里云百炼 DashScope；
# 未配置时对应工具返回空结果（不报错）；图片配额 4 张/run 由 Agent 侧强制
PEXELS_API_KEY=
DASHSCOPE_API_KEY=
# Logo 生成模型（默认对齐 Java LogoGeneratorTool）
IMAGE_MODEL=wan2.2-t2i-flash

# ── 真实 LLM 渠道（2026-09-08 四档接线，src/llm/real.ts 固定分工；密钥不提交，本文件只留模板）──
# 三个渠道密钥须齐全：任一缺失 → createRealLlm 抛错拒启（fail-fast，明确提示缺哪个键）；
# 三个密钥全空 → 离线回退假 LLM（scripted，零在线调用）
# ① 智谱 BigModel：路由档 + 快速档 + 质检档共用（https://bigmodel.cn/usercenter/proj-mgmt/apikeys 取 key）
ZHIPU_API_KEY=
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# ② OpenRouter：标准档（免费模型 50 请求/天，账户累计充 $10 升 1000/天；国内需代理；
#    免费上游可能瞬时过载，渠道层已将 200 包错误体归一化为可重试状态码，SDK 默认重试 2 次）
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# ③ 阿里云 DashScope Coding：深度档（OpenAI 兼容，qwen3.7-plus 默认带思考）
DASHSCOPE_CODING_API_KEY=
# DASHSCOPE_CODING_BASE_URL=https://coding.dashscope.aliyuncs.com/v1

# 四档模型 id 映射（缺省用 src/llm/real.ts 内置选型；MODEL_* 与渠道固定绑定，勿跨渠道填）：
#   MODEL_ROUTER   → 智谱（路由调用点为后续特性，本键先打通配置）
#   MODEL_FAST     → 智谱（快速/质检档同模型；智谱侧自动关思考，保证 max_output_tokens=3000 可用）
#   MODEL_STANDARD → OpenRouter
#   MODEL_DEEP     → DashScope Coding
# MODEL_ROUTER=
# MODEL_FAST=
# MODEL_STANDARD=
# MODEL_DEEP=
