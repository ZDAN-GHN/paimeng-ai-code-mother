# Java↔Python 内部令牌（与 Java 侧 python-agent.token 保持一致）
PYTHON_AGENT_TOKEN=dev-token-change-me

# 工作区根目录（与 Java 侧 CODE_OUTPUT_ROOT_DIR 为同一绝对路径；默认 {repo}/tmp/code_output）
# WORKSPACE_ROOT=

# PostgreSQL DSN（仅用于 LangGraph checkpoint）
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/paimeng

# Java 后端地址（完成回调目标；context-path 为 /api）
JAVA_BASE_URL=http://localhost:8123

# 模型配置（DeepSeek，OpenAI 兼容规范）
MODEL_BASE_URL=https://api.deepseek.com
MODEL_API_KEY=
MODEL_NAME=deepseek-chat
REASONING_MODEL_NAME=deepseek-reasoner

# 阿里云 DashScope（图片生成）
DASHSCOPE_API_KEY=
IMAGE_MODEL=wan2.2-t2i-flash

# Pexels（内容图片搜索，与 Java 侧 pexels.api-key 同值）
# PEXELS_API_KEY=
