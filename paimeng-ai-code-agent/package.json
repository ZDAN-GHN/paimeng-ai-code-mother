{
  "name": "paimeng-ai-code-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "assets:import": "tsx scripts/import-assets.ts",
    "infra:up": "tsx scripts/infra.ts",
    "infra:status": "docker compose --env-file .env -f compose.yaml ps",
    "infra:stop": "docker compose --env-file .env -f compose.yaml stop",
    "verify:infra": "tsx --env-file=.env scripts/verify-infra.ts",
    "dev": "tsx scripts/durable-dev.ts",
    "durable:harness": "node --env-file=.env --import tsx --conditions=react-server src/server/durable/harness-server.ts",
    "durable:pg": "tsx --env-file=.env scripts/durable-pg.ts",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "type-check": "rm -rf .next/types && next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:e2e:dev": "E2E_APP_MODE=dev E2E_APP_PORT=3020 E2E_PREVIEW_PORT=3021 tsx scripts/test-e2e.ts tests/e2e/dev-warnings.spec.ts",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "db:test:setup": "tsx --env-file=.env scripts/test-database.ts",
    "db:import": "tsx --conditions=react-server --env-file=.env scripts/import-legacy.ts",
    "db:admin": "tsx --env-file=.env scripts/admin.ts",
    "db:init-models": "tsx --conditions=react-server --env-file=.env scripts/initialize-models.ts",
    "check:ui": "tsx scripts/check-ui-patterns.ts",
    "check:e2e": "tsx scripts/check-e2e-patterns.ts",
    "verify:boundary": "tsx scripts/verify-boundary.ts",
    "verify:restart": "tsx --env-file=.env scripts/verify-restart.ts",
    "preview": "tsx --conditions=react-server --env-file=.env scripts/preview.ts",
    "test:e2e:isolated": "tsx scripts/test-e2e.ts",
    "verify:parity": "node scripts/verify-parity.mjs",
    "check:fast": "npm run check:ui && npm run check:e2e && npm run verify:boundary",
    "durable:inspect": "tsx --env-file=.env scripts/durable-inspect.ts",
    "hooks:install": "git config core.hooksPath paimeng-ai-code-agent/scripts/hooks && echo \"hooks 已启用：pre-commit=check:fast, pre-push=type-check\"",
    "test:system": "vitest run --project system",
    "test:all": "vitest run",
    "dev:web": "next dev --hostname 127.0.0.1 --port 3000",
    "versions:backfill": "NODE_OPTIONS=\"--import ./scripts/lib/register-server-only.mjs\" tsx --env-file=.env scripts/backfill-versions.ts",
    "versions:titles": "NODE_OPTIONS=\"--import ./scripts/lib/register-server-only.mjs\" tsx --env-file=.env scripts/backfill-version-titles.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.78",
    "@ai-sdk/openai": "4.0.91",
    "@ai-sdk/openai-compatible": "3.0.65",
    "@ai-sdk/provider": "4.0.24",
    "@ai-sdk/react": "4.0.133",
    "@ant-design/icons": "6.1.0",
    "@ant-design/nextjs-registry": "1.3.0",
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "ai": "7.0.130",
    "antd": "6.6.5",
    "archiver": "7.0.1",
    "drizzle-orm": "0.45.3",
    "ipaddr.js": "2.2.0",
    "next": "16.4.0",
    "pg": "8.23.1",
    "playwright": "1.63.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "redis": "6.3.0",
    "rehype-highlight": "7.0.2",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "sharp": "^0.35.5",
    "undici": "7.30.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/archiver": "6.0.3",
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "prettier": "3.5.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
