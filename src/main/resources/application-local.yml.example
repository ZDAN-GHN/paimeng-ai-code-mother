# 本地环境配置模板：复制为 application-local.yml 后按需填写（application-local.yml 已 gitignore，不入库）
# 基础设施为 Docker 化的 MySQL/Redis（docker-compose.yml），与仓库根目录 .env 配套
spring:
  datasource:
    url: jdbc:mysql://localhost:3306/paimeng_ai_code_mother
    username: root
    # 与仓库根目录 .env 的 MYSQL_ROOT_PASSWORD 一致
    password: your-mysql-password
  data:
    redis:
      host: localhost
      port: 6379
      password:
      database: 0

# 硅基流动（Logo 图片生成，Kolors 免费模型；接口文档 https://api-docs.siliconflow.cn/docs/api/images-generations-post）
siliconflow:
  api-key: your-siliconflow-api-key
  image-model: Kwai-Kolors/Kolors

# TS Agent 链路配置（灰度开关 + 短时 JWT；secret 与 paimeng-ai-code-agent/.env 的 JWT_SECRET 同值）
ts-agent:
  enabled: true
  jwt:
    secret: your-jwt-secret-shared-with-ts-agent
    ttl-minutes: 10

# Java 内部 API Bearer 服务令牌（TS Agent 调内部端点时校验；与 paimeng-ai-code-agent/.env 的 JAVA_INTERNAL_TOKEN 同值）
internal-api:
  token: your-internal-api-token

# COS 占位配置（本地联调）：CosClientConfig 按五键条件装配，缺失则 CosManager 无 bean 导致启动失败；
# 本地不真实触达 COS（截图/上传不在本地联调路径），占位值仅满足 bean 装配
cos:
  client:
    host: http://localhost
    secretId: local-placeholder
    secretKey: local-placeholder
    region: ap-guangzhou
    bucket: local-placeholder

# langchain4j 路由模型（createApp 智能路由调用，T21 后 Java 侧唯一保留的 AI 调用）：
# 复用硅基流动 OpenAI 兼容端点 + 免费文本模型
langchain4j:
  open-ai:
    routing-chat-model:
      base-url: https://api.siliconflow.cn/v1
      api-key: your-siliconflow-api-key
      model-name: Qwen/Qwen2.5-7B-Instruct
      max-tokens: 64
      temperature: 0.1
